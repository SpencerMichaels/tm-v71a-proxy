)) (hide yes)))) (symbol (lib_id "Kenwood_Proxy:Device_R") (at 152.4 182.88 0) (unit 1) (in_bom yes) (on_board yes) (dnp no) (uuid "faed539d-9716-5afd-be0c-90f9a85ffc34") (property "Reference" "R7" (at 156.21 176.53 0) (effects (font (size 1.27 1.27)))) (property "Value" "10k" (at 156.21 179.07 0) (effects (font (size 1.27 1.27)))) (property "Footprint" "Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm_P10.16mm_Horizontal" (at 0 0 0) (effects (font (size 1.27 1.27)) (hide yes))) (property "Datasheet" "" (at 0 0 0) (effects (font (size 1.27 1.27)) (hide yes))) (property "MPN" "MFR-25FBF52-10K" (at 0 0 0) (effects (font (size 1.27 1.27)) (hide yes))) (property "Manufacturer" "YAGEO" (at 0 0 0) (effects (font (size 1.27 1.27)) (hide yes))) (property "Assembly" "HAND_THT" (at 0 0 0) (effects (font (size 1.27 1.27)) (hide yes))) (property "DesignNote" "MCU USART1 RX tap on the head stream (logging); limits clamp current when U1 is unpowered" (at 0 0 0) (effects (font (size 1.27 1.27)) (hide yes))) (pin "1" (uuid "97219871-ce85-5ece-ba4e-a1a3f4bb37da")) (pin "2" (uuid "385dc0c1-da06-555f-b24c-e645d6c8eeb0")) (instances (project "kenwood_proxy" (path "/4922d4c6-9842-5666-9f3f-f015399c8583/39fbcc2b-989d-55a5-b553-e6908a02e8ee" (reference "R7") (unit 1))))) (text "HEAD_TXD -> BODY RX is direct copper (J2 pin 3 = J1 pin 3); the MCU only listens.\nBODY_TXD -> HEAD RX goes only through the MCU (full proxy): body bytes are received on TAP_BODY,\nbrightness packets rewritten, everything else forwarded byte-for-byte via R2. Head input has its own 47k pull-up,\nso it idles high while the MCU is in reset or being programmed. Recovery if U1 fails: pull U1 and fit JP1." (at 139.7 213.36 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "a29a4f7f-f631-51fa-b0fe-2c80b5505ebf")) (embedded_fonts no))
